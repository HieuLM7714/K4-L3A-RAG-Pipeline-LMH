# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openrouter | openai | gemini | anthropic
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash

# Generation providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
